# Copy this file to .env (gitignored) and fill in your own paths.
# .env is never committed — it's the only place server-specific info belongs.

# Absolute filesystem path of the folder the PDFs are published to. deploy.sh
# creates it if needed and puts the build's folders inside ("Fancy CV",
# "Scannable CV"). Quote it if it contains spaces: this file is sourced by bash.
NEXTCLOUD_TARGET_DIR="/ruta/al/teu/nextcloud/userdata/usuari/files/Documents/Feina/Currículum Vitae"

# The same folder as Nextcloud's `occ files:scan --path=` expects it
# (relative to the user's storage root).
NEXTCLOUD_SCAN_PATH="/usuari/files/Documents/Feina/Currículum Vitae"

# Optional: command used to run occ. Defaults to a native install
# (`sudo -u www-data php /var/www/nextcloud/occ`). For Docker, e.g.:
# NEXTCLOUD_OCC="sudo docker exec --user www-data nextcloud-app php occ"

# Optional: absolute path to a log file. If set, deploy.sh's own output is
# duplicated there in addition to wherever it's invoked from (terminal, cron,
# or a systemd unit) — leave unset to skip file logging entirely.
DEPLOY_LOG_FILE=/ruta/al/teu/cv-deploy.log
